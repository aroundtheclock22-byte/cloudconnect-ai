{
  "title": "CloudConnect — API & Telephony",
  "uid": "cloudconnect-api",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "type": "timeseries", "title": "Requests/s by status", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (status) (rate(cc_http_request_duration_seconds_count[1m]))" }] },
    { "type": "timeseries", "title": "p50 / p95 / p99 latency", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }, "targets": [
      { "expr": "histogram_quantile(0.5, sum(rate(cc_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
      { "expr": "histogram_quantile(0.95, sum(rate(cc_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
      { "expr": "histogram_quantile(0.99, sum(rate(cc_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }] },
    { "type": "timeseries", "title": "Telephony webhook latency (p95)", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, route) (rate(cc_http_request_duration_seconds_bucket{route=~\"/v1/telephony/.*\"}[5m])))" }] },
    { "type": "stat", "title": "5xx error ratio", "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 }, "targets": [{ "expr": "sum(rate(cc_http_errors_total[5m])) / sum(rate(cc_http_request_duration_seconds_count[5m]))" }] },
    { "type": "stat", "title": "Event loop lag p99", "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 }, "targets": [{ "expr": "max(cc_nodejs_eventloop_lag_p99_seconds)" }] }
  ]
}
